{
  "routes": [
    {
      "route": "/api/*",
      "backend": "externalApi"
    }
  ],
  "backend": {
    "externalApi": {
      "target": "invoice-function-backend.azurewebsites.net",
      "allowedStatusCodes": [400, 401, 403, 404, 500]
    }
  },
  "globalHeaders": {
    "Access-Control-Allow-Origin": "*"
  }
}